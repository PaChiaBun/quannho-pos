# ═══════════════════════════════════════════════════════════════════════════
# SERVER-SIDE STAGING ENVIRONMENT VARIABLES PLACEHOLDER
# File: supabase/.env.staging.server.example
# Target compose project: quannho_staging
# Note: Variables must match exact names used in docker-compose.staging.yml.
# NEVER commit real keys or copy keys from Production.
# ═══════════════════════════════════════════════════════════════════════════

# Database Configuration
POSTGRES_PASSWORD=YOUR_STAGING_POSTGRES_PASSWORD_MIN_20_CHARS
POSTGRES_DB=postgres

# JWT Signing Secret (MUST be generated fresh for staging, minimum 32 characters)
JWT_SECRET=YOUR_STAGING_JWT_SECRET_SECURE_RANDOM_MIN_32_CHARS

# Realtime Dedicated Secrets (Separated from JWT_SECRET)
REALTIME_SECRET_KEY_BASE=YOUR_STAGING_REALTIME_SECRET_KEY_BASE_MIN_64_CHARS
REALTIME_DB_ENC_KEY=YOUR_STAGING_REALTIME_DB_ENC_KEY_MIN_32_CHARS
REALTIME_ERLANG_COOKIE=YOUR_STAGING_REALTIME_ERLANG_COOKIE_MIN_32_CHARS

# API Gateway Public Keys (Generated using staging JWT secret above)
ANON_KEY=YOUR_STAGING_ANON_KEY_PLACEHOLDER
SERVICE_ROLE_KEY=YOUR_STAGING_SERVICE_ROLE_KEY_PLACEHOLDER

# Domain Endpoints
STAGING_STUDIO_DOMAIN=quannho-staging-db.lpm.vn
STAGING_API_DOMAIN=quannho-staging.lpm.vn
