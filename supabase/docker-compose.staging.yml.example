# ═══════════════════════════════════════════════════════════════════════════
# DOCKER COMPOSE CONFIGURATION FOR STANDALONE STAGING (EXACT INIT MOUNTS)
# Project: quannho_staging
# File: supabase/docker-compose.staging.yml.example
# Image tags empirically pinned to match Production VPS (Audit: 2026-08-01)
# All ports mapped to host are non-overlapping with Production.
# Individual init scripts mounted to exact destinations as audited from Production.
# ═══════════════════════════════════════════════════════════════════════════

name: quannho_staging

services:
  # 1. PostgreSQL Database Service (Profile: core)
  staging-db:
    profiles: ["core"]
    image: supabase/postgres:17.6.1.136
    healthcheck:
      test: ["CMD", "pg_isready", "-U", "postgres"]
      interval: 5s
      timeout: 5s
      retries: 10
    environment:
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB}
    ports:
      - "127.0.0.1:5433:5432"
    volumes:
      - staging_db_data:/var/lib/postgresql/data
      - ./volumes/db/roles.sql:/docker-entrypoint-initdb.d/init-scripts/99-roles.sql:ro
      - ./volumes/db/jwt.sql:/docker-entrypoint-initdb.d/init-scripts/99-jwt.sql:ro
      - ./volumes/db/webhooks.sql:/docker-entrypoint-initdb.d/init-scripts/98-webhooks.sql:ro
      - ./volumes/db/_supabase.sql:/docker-entrypoint-initdb.d/migrations/97-_supabase.sql:ro
      - ./volumes/db/logs.sql:/docker-entrypoint-initdb.d/migrations/99-logs.sql:ro
      - ./volumes/db/pooler.sql:/docker-entrypoint-initdb.d/migrations/99-pooler.sql:ro
      - ./volumes/db/realtime.sql:/docker-entrypoint-initdb.d/migrations/99-realtime.sql:ro
    restart: "no"
    mem_limit: 256m
    cpus: "0.25"

  # 2. PostgREST REST API Service (Profile: core)
  staging-rest:
    profiles: ["core"]
    image: postgrest/postgrest:v14.12
    depends_on:
      staging-db:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "nc", "-z", "localhost", "3000"]
      interval: 10s
      timeout: 5s
      retries: 5
    environment:
      PGRST_DB_URI: postgres://authenticator:${POSTGRES_PASSWORD}@staging-db:5432/${POSTGRES_DB}
      PGRST_DB_SCHEMAS: public,storage
      PGRST_DB_ANON_ROLE: anon
      PGRST_JWT_SECRET: ${JWT_SECRET}
    ports:
      - "127.0.0.1:3010:3000"
    restart: "no"
    mem_limit: 96m
    cpus: "0.15"

  # 3. Kong API Gateway Service (Profile: core)
  staging-kong:
    profiles: ["core"]
    image: kong/kong:3.9.1
    depends_on:
      - staging-rest
    healthcheck:
      test: ["CMD", "kong", "health"]
      interval: 10s
      timeout: 5s
      retries: 5
    environment:
      KONG_DATABASE: "off"
      KONG_DECLARATIVE_CONFIG: /var/lib/kong/kong.yml
      KONG_DNS_ORDER: LAST,A,CNAME
      SUPABASE_ANON_KEY: ${ANON_KEY}
      SUPABASE_SERVICE_KEY: ${SERVICE_ROLE_KEY}
    volumes:
      - ./kong.staging.yml:/var/lib/kong/kong.yml:ro
    ports:
      - "127.0.0.1:8010:8000"
    restart: "no"
    mem_limit: 128m
    cpus: "0.15"

  # 4. GoTrue Auth Service (Profile: auth)
  staging-auth:
    profiles: ["auth"]
    image: supabase/gotrue:v2.189.0
    depends_on:
      staging-db:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:9999/health"]
      interval: 10s
      timeout: 5s
      retries: 5
    environment:
      GOTRUE_API_HOST: 0.0.0.0
      GOTRUE_API_PORT: 9999
      GOTRUE_API_EXTERNAL_URL: https://${STAGING_API_DOMAIN}/auth/v1
      GOTRUE_SITE_URL: https://${STAGING_API_DOMAIN}
      GOTRUE_DB_DRIVER: postgres
      GOTRUE_DB_DATABASE_URL: postgres://supabase_auth_admin:${POSTGRES_PASSWORD}@staging-db:5432/${POSTGRES_DB}
      GOTRUE_JWT_SECRET: ${JWT_SECRET}
      GOTRUE_JWT_EXP: 3600
      GOTRUE_JWT_AUD: authenticated
      GOTRUE_JWT_DEFAULT_GROUP_NAME: authenticated
    ports:
      - "127.0.0.1:9998:9999"
    restart: "no"
    mem_limit: 128m
    cpus: "0.15"

  # 5. Realtime Service (Profile: realtime)
  staging-realtime:
    profiles: ["realtime"]
    image: supabase/realtime:v2.102.3
    depends_on:
      staging-db:
        condition: service_healthy
    environment:
      PORT: 4000
      DB_HOST: staging-db
      DB_PORT: 5432
      DB_NAME: ${POSTGRES_DB}
      DB_USER: supabase_admin
      DB_PASSWORD: ${POSTGRES_PASSWORD}
      JWT_SECRET: ${JWT_SECRET}
      SECRET_KEY_BASE: ${REALTIME_SECRET_KEY_BASE}
      DB_ENC_KEY: ${REALTIME_DB_ENC_KEY}
      ERLANG_COOKIE: ${REALTIME_ERLANG_COOKIE}
      APP_NAME: realtime
      SEED_SELF_HOST: "true"
      DB_AFTER_CONNECT_QUERY: "SET search_path TO public, realtime;"
      REPLICA_RUN_MAINTENANCE_TASK: "false"
    ports:
      - "127.0.0.1:4010:4000"
    restart: "no"
    mem_limit: 128m
    cpus: "0.15"

  # 6. Image Proxy Service (Profile: storage)
  staging-imgproxy:
    profiles: ["storage"]
    image: darthsim/imgproxy:v3.30.1
    environment:
      IMGPROXY_BIND: ":8080"
      IMGPROXY_LOCAL_FILESYSTEM_ROOT: /
    ports:
      - "127.0.0.1:8088:8080"
    restart: "no"
    mem_limit: 64m
    cpus: "0.05"

  # 7. Storage API Service (Profile: storage)
  staging-storage:
    profiles: ["storage"]
    image: supabase/storage-api:v1.60.4
    depends_on:
      staging-db:
        condition: service_healthy
      staging-imgproxy:
        condition: service_started
    environment:
      ANON_KEY: ${ANON_KEY}
      SERVICE_KEY: ${SERVICE_ROLE_KEY}
      POSTGREST_URL: http://staging-rest:3000
      PGRST_JWT_SECRET: ${JWT_SECRET}
      DATABASE_URL: postgres://supabase_storage_admin:${POSTGRES_PASSWORD}@staging-db:5432/${POSTGRES_DB}
      TENANT_ID: staging-tenant
      REGION: local
      FILE_SIZE_LIMIT: 52428800
      STORAGE_BACKEND: file
      FILE_STORAGE_BACKEND_PATH: /var/lib/storage
      IMGPROXY_URL: http://staging-imgproxy:8080
    ports:
      - "127.0.0.1:5010:5000"
    volumes:
      - staging_storage_data:/var/lib/storage
    restart: "no"
    mem_limit: 96m
    cpus: "0.10"

  # 8. Postgres Meta API Service (Profile: admin)
  staging-meta:
    profiles: ["admin"]
    image: supabase/postgres-meta:v0.96.6
    depends_on:
      staging-db:
        condition: service_healthy
    environment:
      PG_META_PORT: 8080
      PG_META_DB_HOST: staging-db
      PG_META_DB_PORT: 5432
      PG_META_DB_NAME: ${POSTGRES_DB}
      PG_META_DB_USER: postgres
      PG_META_DB_PASSWORD: ${POSTGRES_PASSWORD}
    ports:
      - "127.0.0.1:8080:8080"
    restart: "no"
    mem_limit: 64m
    cpus: "0.05"

  # 9. Supabase Studio Dashboard Service (Profile: admin)
  staging-studio:
    profiles: ["admin"]
    image: supabase/studio:2026.07.07-sha-a6a04f2
    depends_on:
      staging-meta:
        condition: service_started
    environment:
      STUDIO_PG_META_URL: http://staging-meta:8080
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      SUPABASE_URL: http://staging-kong:8000
      SUPABASE_PUBLIC_URL: https://${STAGING_API_DOMAIN}
    ports:
      - "127.0.0.1:3013:3000"
    restart: "no"
    mem_limit: 128m
    cpus: "0.10"

volumes:
  staging_db_data:
  staging_storage_data:
